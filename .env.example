# Local development settings. Copy to `.env` (gitignored) and fill in.
# The devcontainer creates `.env` from this file automatically and generates JWT_SECRET.
# Load into your shell before running the backend:  set -a; source .env; set +a

# --- Database (also read by docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/Finance_Tracker
DB_USERNAME=postgres
DB_PASSWORD=localdev

# --- Auth ---
# Base64-encoded HMAC key of at least 32 bytes. Generate with: openssl rand -base64 32
JWT_SECRET=

# --- Mail (optional; password-reset emails fail without it) ---
MAIL_USERNAME=
MAIL_PASSWORD=
